# Global OpenTelemetry Configuration
ENABLE_GLOBAL_TELEMETRY=true
GLOBAL_JAEGER_ENDPOINT=http://localhost:14268/api/traces
GLOBAL_PROMETHEUS_PORT=9090

# Global Logging Configuration
GLOBAL_LOG_LEVEL=info
GLOBAL_LOG_FORMAT=json
GLOBAL_LOG_CORRELATION_ENABLED=true
GLOBAL_LOG_SANITIZATION_ENABLED=true

# Global Metrics Configuration
GLOBAL_METRICS_ENABLED=true
GLOBAL_METRICS_EXPORT_INTERVAL=10000
GLOBAL_METRICS_RETENTION_DAYS=30

# Global Health Check Configuration
GLOBAL_HEALTH_CHECK_INTERVAL=30000
GLOBAL_HEALTH_CHECK_TIMEOUT=5000

# Global Performance Monitoring
GLOBAL_PERFORMANCE_MONITORING_ENABLED=true
GLOBAL_SLOW_REQUEST_THRESHOLD_MS=5000
GLOBAL_ERROR_RATE_THRESHOLD_PERCENT=5

# Instrumentation Control
GLOBAL_HTTP_INSTRUMENTATION=true
GLOBAL_NESTJS_INSTRUMENTATION=true
GLOBAL_REDIS_INSTRUMENTATION=true
GLOBAL_TYPEORM_INSTRUMENTATION=true
GLOBAL_EXPRESS_INSTRUMENTATION=true

# Observability Features
GLOBAL_TRACE_SAMPLING_RATE=0.1
GLOBAL_METRICS_DETAILED=false
GLOBAL_REQUEST_BODY_LOGGING=false
GLOBAL_RESPONSE_BODY_LOGGING=false

# Development / Production Settings
GLOBAL_OBSERVABILITY_DEBUG=false
GLOBAL_CONSOLE_INSTRUMENTATION=false